{
  "$defs": {
    "BatchAttempt": {
      "additionalProperties": false,
      "description": "One immutable Attempt in a complete Trial chain.",
      "properties": {
        "attempt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "evaluation": {
          "anyOf": [
            {
              "$ref": "#/$defs/BatchEvaluationPackage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lifecycle": {
          "anyOf": [
            {
              "$ref": "#/$defs/BatchLifecycleRecord"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ordinal": {
          "exclusiveMinimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "predecessor_attempt_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predecessor Attempt Id"
        },
        "resources": {
          "$ref": "#/$defs/BatchAttemptResources"
        },
        "retry_eligible": {
          "title": "Retry Eligible",
          "type": "boolean"
        },
        "schema_version": {
          "const": "agent.evaluator.batch-attempt/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_attempt_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "title": "Source Attempt Id",
          "type": "string"
        },
        "source_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Manifest Sha256",
          "type": "string"
        },
        "trial_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trial Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "attempt_id",
        "source_attempt_id",
        "trial_id",
        "ordinal",
        "source_manifest_sha256",
        "retry_eligible",
        "resources"
      ],
      "title": "BatchAttempt",
      "type": "object"
    },
    "BatchAttemptResources": {
      "additionalProperties": false,
      "description": "Verified resource facts for one Attempt; missing values remain unavailable.",
      "properties": {
        "cost_microunits": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Microunits"
        },
        "duration_milliseconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Milliseconds"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "usage_receipt_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage Receipt Sha256"
        }
      },
      "title": "BatchAttemptResources",
      "type": "object"
    },
    "BatchEvaluationFile": {
      "additionalProperties": false,
      "description": "One byte-exact file embedded from a closed Evaluation Package.",
      "properties": {
        "content_base64": {
          "title": "Content Base64",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256",
        "content_base64"
      ],
      "title": "BatchEvaluationFile",
      "type": "object"
    },
    "BatchEvaluationPackage": {
      "additionalProperties": false,
      "description": "A complete evaluator-owned package, embedded without host paths.",
      "properties": {
        "files": {
          "items": {
            "$ref": "#/$defs/BatchEvaluationFile"
          },
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "package_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Package Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "agent.evaluator.batch-evaluation-package/v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "package_sha256",
        "files"
      ],
      "title": "BatchEvaluationPackage",
      "type": "object"
    },
    "BatchLifecycleRecord": {
      "additionalProperties": false,
      "description": "Normalized, receipt-bound terminal state when no Evaluation Package exists.",
      "properties": {
        "category": {
          "enum": [
            "timed_out",
            "interrupted",
            "infrastructure_start_failure",
            "transient_provider_pre_terminal",
            "runtime_pre_terminal_failure",
            "other_verified_infrastructure_failure"
          ],
          "title": "Category",
          "type": "string"
        },
        "receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receipt Sha256",
          "type": "string"
        },
        "retry_eligible": {
          "title": "Retry Eligible",
          "type": "boolean"
        },
        "schema_version": {
          "const": "agent.evaluator.batch-lifecycle/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_state": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "title": "Source State",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "category",
        "retry_eligible",
        "source_state",
        "receipt_sha256"
      ],
      "title": "BatchLifecycleRecord",
      "type": "object"
    },
    "BatchPlannedTrial": {
      "additionalProperties": false,
      "description": "One RunPlan-declared sample slot in authoritative order.",
      "properties": {
        "case_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "title": "Case Id",
          "type": "string"
        },
        "configuration_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "title": "Configuration Id",
          "type": "string"
        },
        "experiment_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Experiment Id",
          "type": "string"
        },
        "repetition": {
          "exclusiveMinimum": 0,
          "title": "Repetition",
          "type": "integer"
        },
        "slot_index": {
          "exclusiveMinimum": 0,
          "title": "Slot Index",
          "type": "integer"
        },
        "trial_slot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trial Slot Id",
          "type": "string"
        }
      },
      "required": [
        "slot_index",
        "trial_slot_id",
        "case_id",
        "configuration_id",
        "experiment_id",
        "repetition"
      ],
      "title": "BatchPlannedTrial",
      "type": "object"
    },
    "BatchTrial": {
      "additionalProperties": false,
      "description": "One completed planned Trial and its lossless Attempt chain.",
      "properties": {
        "attempts": {
          "items": {
            "$ref": "#/$defs/BatchAttempt"
          },
          "minItems": 1,
          "title": "Attempts",
          "type": "array"
        },
        "case_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "title": "Case Id",
          "type": "string"
        },
        "configuration_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "title": "Configuration Id",
          "type": "string"
        },
        "execution_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Execution Id",
          "type": "string"
        },
        "experiment_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Experiment Id",
          "type": "string"
        },
        "repetition": {
          "exclusiveMinimum": 0,
          "title": "Repetition",
          "type": "integer"
        },
        "run_plan_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Run Plan Id",
          "type": "string"
        },
        "schema_version": {
          "const": "agent.evaluator.batch-trial/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_attempt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Selected Attempt Id",
          "type": "string"
        },
        "slot_index": {
          "exclusiveMinimum": 0,
          "title": "Slot Index",
          "type": "integer"
        },
        "trial_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trial Id",
          "type": "string"
        },
        "trial_slot_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Trial Slot Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "run_plan_id",
        "execution_id",
        "trial_id",
        "slot_index",
        "trial_slot_id",
        "case_id",
        "configuration_id",
        "experiment_id",
        "repetition",
        "selected_attempt_id",
        "attempts"
      ],
      "title": "BatchTrial",
      "type": "object"
    }
  },
  "$id": "https://cernora.dev/schemas/batch-input-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict, canonical, content-identified input for Runtime-neutral aggregation.",
  "properties": {
    "attempt_count": {
      "exclusiveMinimum": 0,
      "title": "Attempt Count",
      "type": "integer"
    },
    "batch_input_id": {
      "minLength": 1,
      "title": "Batch Input Id",
      "type": "string"
    },
    "batch_input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Batch Input Sha256",
      "type": "string"
    },
    "budget_status": {
      "const": "within_budget",
      "title": "Budget Status",
      "type": "string"
    },
    "companion_version": {
      "minLength": 1,
      "title": "Companion Version",
      "type": "string"
    },
    "execution_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Id",
      "type": "string"
    },
    "execution_status": {
      "const": "completed",
      "title": "Execution Status",
      "type": "string"
    },
    "planned_trial_count": {
      "exclusiveMinimum": 0,
      "title": "Planned Trial Count",
      "type": "integer"
    },
    "planned_trials": {
      "items": {
        "$ref": "#/$defs/BatchPlannedTrial"
      },
      "minItems": 1,
      "title": "Planned Trials",
      "type": "array"
    },
    "run_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Plan Id",
      "type": "string"
    },
    "schema_version": {
      "const": "agent.evaluator.batch-input/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "trials": {
      "items": {
        "$ref": "#/$defs/BatchTrial"
      },
      "minItems": 1,
      "title": "Trials",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "batch_input_id",
    "batch_input_sha256",
    "run_plan_id",
    "execution_id",
    "execution_status",
    "budget_status",
    "companion_version",
    "planned_trial_count",
    "attempt_count",
    "planned_trials",
    "trials"
  ],
  "title": "BatchInput",
  "type": "object"
}
