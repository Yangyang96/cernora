{
  "$defs": {
    "BatchAttemptDiagnostics": {
      "additionalProperties": false,
      "properties": {
        "cost_microunits": {
          "$ref": "#/$defs/BatchVerifiedTotal"
        },
        "duration_milliseconds": {
          "$ref": "#/$defs/BatchVerifiedTotal"
        },
        "evaluation_validity_rate": {
          "$ref": "#/$defs/BatchRate"
        },
        "first_attempt_success_rate": {
          "$ref": "#/$defs/BatchRate"
        },
        "first_attempts": {
          "exclusiveMinimum": 0,
          "title": "First Attempts",
          "type": "integer"
        },
        "infrastructure_failures": {
          "items": {
            "$ref": "#/$defs/BatchDistributionEntry"
          },
          "title": "Infrastructure Failures",
          "type": "array"
        },
        "input_tokens": {
          "$ref": "#/$defs/BatchVerifiedTotal"
        },
        "output_tokens": {
          "$ref": "#/$defs/BatchVerifiedTotal"
        },
        "retry_attempts": {
          "minimum": 0,
          "title": "Retry Attempts",
          "type": "integer"
        },
        "retry_rate": {
          "$ref": "#/$defs/BatchRate"
        },
        "total_attempts": {
          "exclusiveMinimum": 0,
          "title": "Total Attempts",
          "type": "integer"
        },
        "trials_with_retry": {
          "minimum": 0,
          "title": "Trials With Retry",
          "type": "integer"
        }
      },
      "required": [
        "total_attempts",
        "first_attempts",
        "retry_attempts",
        "trials_with_retry",
        "first_attempt_success_rate",
        "retry_rate",
        "evaluation_validity_rate",
        "infrastructure_failures",
        "duration_milliseconds",
        "input_tokens",
        "output_tokens",
        "cost_microunits"
      ],
      "title": "BatchAttemptDiagnostics",
      "type": "object"
    },
    "BatchDistributionEntry": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "count"
      ],
      "title": "BatchDistributionEntry",
      "type": "object"
    },
    "BatchFailureCodeCount": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "title": "Code",
          "type": "string"
        },
        "count": {
          "exclusiveMinimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "profile_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "title": "Profile Id",
          "type": "string"
        },
        "profile_version": {
          "minLength": 1,
          "title": "Profile Version",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "profile_version",
        "code",
        "count"
      ],
      "title": "BatchFailureCodeCount",
      "type": "object"
    },
    "BatchGroupSummary": {
      "additionalProperties": false,
      "properties": {
        "behavioral_success_rate": {
          "$ref": "#/$defs/BatchRate"
        },
        "case_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "configuration_id": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configuration Id"
        },
        "evaluation_validity_rate": {
          "$ref": "#/$defs/BatchRate"
        },
        "outcomes": {
          "$ref": "#/$defs/BatchOutcomeCounts"
        },
        "planned_trials": {
          "exclusiveMinimum": 0,
          "title": "Planned Trials",
          "type": "integer"
        },
        "reliable_success_rate": {
          "$ref": "#/$defs/BatchRate"
        }
      },
      "required": [
        "planned_trials",
        "outcomes",
        "evaluation_validity_rate",
        "behavioral_success_rate",
        "reliable_success_rate"
      ],
      "title": "BatchGroupSummary",
      "type": "object"
    },
    "BatchOutcomeCounts": {
      "additionalProperties": false,
      "properties": {
        "behavioral_failed": {
          "minimum": 0,
          "title": "Behavioral Failed",
          "type": "integer"
        },
        "evaluation_invalid": {
          "minimum": 0,
          "title": "Evaluation Invalid",
          "type": "integer"
        },
        "infrastructure_unavailable": {
          "minimum": 0,
          "title": "Infrastructure Unavailable",
          "type": "integer"
        },
        "passed": {
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        }
      },
      "required": [
        "passed",
        "behavioral_failed",
        "evaluation_invalid",
        "infrastructure_unavailable"
      ],
      "title": "BatchOutcomeCounts",
      "type": "object"
    },
    "BatchRate": {
      "additionalProperties": false,
      "properties": {
        "denominator": {
          "minimum": 0,
          "title": "Denominator",
          "type": "integer"
        },
        "numerator": {
          "minimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "numerator",
        "denominator",
        "value"
      ],
      "title": "BatchRate",
      "type": "object"
    },
    "BatchVerifiedTotal": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "available",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "status"
      ],
      "title": "BatchVerifiedTotal",
      "type": "object"
    }
  },
  "$id": "https://cernora.dev/schemas/batch-summary-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Authoritative validity-first summary derived from one Batch Input.",
  "properties": {
    "attempt_diagnostics": {
      "$ref": "#/$defs/BatchAttemptDiagnostics"
    },
    "batch_input_id": {
      "minLength": 1,
      "title": "Batch Input Id",
      "type": "string"
    },
    "batch_input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Batch Input Sha256",
      "type": "string"
    },
    "by_case": {
      "items": {
        "$ref": "#/$defs/BatchGroupSummary"
      },
      "minItems": 1,
      "title": "By Case",
      "type": "array"
    },
    "by_cell": {
      "items": {
        "$ref": "#/$defs/BatchGroupSummary"
      },
      "minItems": 1,
      "title": "By Cell",
      "type": "array"
    },
    "by_configuration": {
      "items": {
        "$ref": "#/$defs/BatchGroupSummary"
      },
      "minItems": 1,
      "title": "By Configuration",
      "type": "array"
    },
    "execution_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Execution Id",
      "type": "string"
    },
    "overall": {
      "$ref": "#/$defs/BatchGroupSummary"
    },
    "profile_failure_codes": {
      "items": {
        "$ref": "#/$defs/BatchFailureCodeCount"
      },
      "title": "Profile Failure Codes",
      "type": "array"
    },
    "run_plan_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Plan Id",
      "type": "string"
    },
    "schema_version": {
      "const": "agent.evaluator.batch-summary/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "summary_id": {
      "minLength": 1,
      "title": "Summary Id",
      "type": "string"
    },
    "summary_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Summary Sha256",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "summary_id",
    "summary_sha256",
    "batch_input_id",
    "batch_input_sha256",
    "run_plan_id",
    "execution_id",
    "overall",
    "by_configuration",
    "by_case",
    "by_cell",
    "attempt_diagnostics",
    "profile_failure_codes"
  ],
  "title": "BatchSummary",
  "type": "object"
}
