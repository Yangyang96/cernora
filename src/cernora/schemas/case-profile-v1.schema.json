{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cernora-case-profile-v1.schema.json",
  "title": "CaseProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "profile_version", "description", "cases", "scorer_policy", "gate_policy"],
  "properties": {
    "schema_version": {"const": "agent.evaluator.case-profile/v1"},
    "profile_id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "profile_version": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
    "scorer_policy": {"$ref": "#/$defs/scorerPolicy"},
    "gate_policy": {"$ref": "#/$defs/gatePolicy"}
  },
  "$defs": {
    "fixtureReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "path", "sha256"],
      "properties": {
        "fixture_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "caseInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt"],
      "properties": {
        "prompt": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "case_version", "case_set", "input", "declared_capabilities", "fixture_references"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "case_version": {"type": "string", "minLength": 1},
        "case_set": {"type": "string", "minLength": 1},
        "input": {"$ref": "#/$defs/caseInput"},
        "declared_capabilities": {"type": "array", "items": {"type": "string"}},
        "fixture_references": {"type": "array", "items": {"$ref": "#/$defs/fixtureReference"}},
        "tags": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scorerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "required_observations"],
      "properties": {
        "policy_version": {"type": "string", "minLength": 1},
        "required_observations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "gatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_version", "required_score_ids"],
      "properties": {
        "policy_version": {"type": "string", "minLength": 1},
        "required_score_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "invalid_result": {"const": "inconclusive"}
      }
    }
  }
}
