{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cernora-evaluation-report-v1.schema.json",
  "title": "EvaluationReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluation_id",
    "evidence_id",
    "score_id",
    "decision_id",
    "evaluation_input_sha256",
    "authority_id",
    "authority_sha256",
    "conclusion",
    "evaluation_validity",
    "records"
  ],
  "properties": {
    "schema_version": {"const": "agent.evaluator.evaluation-report/v1"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "evidence_id": {"type": "string", "minLength": 1},
    "score_id": {"type": "string", "minLength": 1},
    "decision_id": {"type": "string", "minLength": 1},
    "evaluation_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority_id": {"type": "string", "minLength": 1},
    "authority_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "conclusion": {"enum": ["pass", "fail", "inconclusive"]},
    "evaluation_validity": {"enum": ["valid", "invalid", "unavailable"]},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "result-record-v1.schema.json"},
      "contains": {
        "type": "object",
        "required": ["role"],
        "properties": {"role": {"enum": ["outcome", "constraint"]}}
      },
      "minContains": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"evaluation_validity": {"const": "valid"}},
        "required": ["evaluation_validity"]
      },
      "then": {
        "properties": {
          "conclusion": {"enum": ["pass", "fail"]},
          "records": {
            "items": {
              "if": {
                "properties": {"role": {"enum": ["outcome", "constraint"]}},
                "required": ["role"]
              },
              "then": {
                "properties": {
                  "value_type": {"const": "boolean"},
                  "validity": {"const": "valid"}
                }
              }
            }
          }
        }
      },
      "else": {"properties": {"conclusion": {"const": "inconclusive"}}}
    },
    {
      "if": {
        "properties": {"evaluation_validity": {"const": "invalid"}},
        "required": ["evaluation_validity"]
      },
      "then": {
        "properties": {
          "records": {
            "contains": {
              "type": "object",
              "required": ["role", "validity"],
              "properties": {
                "role": {"enum": ["outcome", "constraint"]},
                "validity": {"const": "invalid"}
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {"evaluation_validity": {"const": "unavailable"}},
        "required": ["evaluation_validity"]
      },
      "then": {
        "properties": {
          "records": {
            "contains": {
              "type": "object",
              "required": ["role", "validity"],
              "properties": {
                "role": {"enum": ["outcome", "constraint"]},
                "validity": {"enum": ["unavailable", "not_applicable"]}
              }
            },
            "minContains": 1,
            "not": {
              "contains": {
                "type": "object",
                "required": ["role", "validity"],
                "properties": {
                  "role": {"enum": ["outcome", "constraint"]},
                  "validity": {"const": "invalid"}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluation_validity": {"const": "valid"},
          "conclusion": {"const": "pass"}
        },
        "required": ["evaluation_validity", "conclusion"]
      },
      "then": {
        "properties": {
          "records": {
            "items": {
              "if": {
                "properties": {"role": {"enum": ["outcome", "constraint"]}},
                "required": ["role"]
              },
              "then": {"properties": {"value": {"const": true}}}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evaluation_validity": {"const": "valid"},
          "conclusion": {"const": "fail"}
        },
        "required": ["evaluation_validity", "conclusion"]
      },
      "then": {
        "properties": {
          "records": {
            "contains": {
              "type": "object",
              "required": ["role", "value"],
              "properties": {
                "role": {"enum": ["outcome", "constraint"]},
                "value": {"const": false}
              }
            },
            "minContains": 1
          }
        }
      }
    }
  ]
}
