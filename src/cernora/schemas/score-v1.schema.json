{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cernora-score-v1.schema.json",
  "title": "Score",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "score_id", "evidence_id", "scorer_version", "observations"],
  "properties": {
    "schema_version": {"const": "agent.evaluator.score/v1"},
    "score_id": {"type": "string", "minLength": 1},
    "evidence_id": {"type": "string", "minLength": 1},
    "scorer_version": {"type": "string", "minLength": 1},
    "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}}
  },
  "$defs": {
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "locator"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "applicability", "value", "evidence_references"],
      "properties": {
        "observation_id": {"type": "string", "minLength": 1},
        "applicability": {"enum": ["observed", "not_applicable", "invalid"]},
        "value": {"type": ["boolean", "integer", "string", "object", "null"]},
        "reason": {"type": ["string", "null"]},
        "evidence_references": {"type": "array", "items": {"$ref": "#/$defs/reference"}}
      }
    }
  }
}
